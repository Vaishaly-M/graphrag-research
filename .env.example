GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT_NAME=projects/your_project_number
GEMINI_PROJECT_NUMBER=your_project_number
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_RPM=10
# Optional: only read when config/experiment.yaml -> llm_key_pool.enabled
# is true, and only for multiple Gemini API keys YOU legitimately hold
# (e.g. separate GCP projects/billing under your own account). Each key
# is still individually rate-limited to GEMINI_RPM. Do not populate this
# with keys from separate free-tier accounts created to evade Google's
# per-account rate limit.
# GEMINI_API_KEYS=your_first_key,your_second_key

NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=your_neo4j_database

GITHUB_TOKEN=your_github_personal_access_token_here
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
